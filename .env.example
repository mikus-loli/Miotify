PORT=8080
# 留空则首次启动自动生成并保存在数据库中（生产强烈建议显式设置）
JWT_SECRET=
JWT_EXPIRES_IN=7d
DB_PATH=./data/miotify.db
# ⚠️ 生产环境务必修改默认管理员密码！
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=admin
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
MAX_MESSAGE_LENGTH=5000
MAX_MESSAGES_PER_APP=200
# 日志保留策略：按条数和天数双重上限，0 表示不限制
LOG_RETENTION_COUNT=5000
LOG_RETENTION_DAYS=30
# 跨域白名单（逗号分隔）。留空 = 同源部署，禁止跨域（推荐）
# CORS_ORIGIN=https://example.com,https://app.example.com
